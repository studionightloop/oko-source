{
  "schemaVersion": 1,
  "id": "anikoto",
  "name": "AniKoto",
  "category": "anime",
  "rank": 1,
  "version": "0.2.1",
  "status": "active",
  "language": "en",
  "contentType": "video",
  "engine": "hianime-clone-static",
  "mirrors": [
    "https://anikototv.to",
    "https://anichi.to",
    "https://anisuge.tv",
    "https://animesogo.to",
    "https://anixtv.me",
    "https://animixplay.tube",
    "https://animepahetv.to",
    "https://9animez.org",
    "https://hianimez.org"
  ],
  "primaryMirror": "https://anikototv.to",
  "labeling": {
    "provider": "everythingmoe",
    "tags": [
      "Scraper",
      "Self-host",
      "Modern interface",
      "Dub friendly",
      "Hard-sub",
      "Soft-sub"
    ],
    "posterSource": "cdn.anipixcdn.co thumbnail (300x400)",
    "qualitySource": "HD badge + sub/dub episode counts",
    "notes": "Rank #1 on everythingmoe. Anichi uses /anime/ path, others /watch/ — same hash slugs."
  },
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14)",
    "Referer": "https://anikototv.to/"
  },
  "limits": {
    "timeoutMs": 15000,
    "maxConcurrent": 2
  },
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "discovery": {
    "request": {
      "method": "GET",
      "urlTemplate": "{mirror}/home"
    },
    "response": {
      "format": "html"
    },
    "extract": {
      "rows": [
        "spotlight/trending/top10",
        "most-viewed",
        "latest-updated",
        "new-release",
        "genre/:name",
        "type/:name",
        "status/:name",
        "az-list/:letter",
        "schedule"
      ],
      "collection": "#list-items div.item",
      "fields": {
        "sourceID": "a[href*=/watch/] -> strip prefix/suffix",
        "title": "a.d-title text",
        "posterURL": "div.poster img[src]"
      }
    }
  },
  "search": {
    "request": {
      "method": "GET",
      "urlTemplate": "{mirror}/filter?keyword={query}&page={page}"
    },
    "response": {
      "format": "html"
    },
    "extract": {
      "collection": "#list-items div.item",
      "suggestAPI": "/search/suggest?keyword={query} -> JSON",
      "fields": {
        "sourceID": "watch/ slug-hash (e.g. one-piece-odmau)",
        "title": "text",
        "posterURL": "cdn.anipixcdn.co"
      }
    },
    "okoMap": "listItem -> CircleFtpPost{id=slug-hash, title, poster}"
  },
  "details": {
    "request": {
      "method": "GET",
      "urlTemplate": "{mirror}/watch/{titleID}"
    },
    "response": {
      "format": "html"
    },
    "extract": {
      "sharedID": "#watch-main[data-id] (e.g. 1642)",
      "title": "h1.d-title",
      "synopsis": "div.synopsis",
      "poster": "cdn.anipixcdn.co",
      "meta": "Type/Year/Status/Genres/MAL score/Studios/PG-13/HD"
    }
  },
  "episodes": {
    "request": {
      "method": "GET",
      "urlTemplate": "{mirror}/ajax/episode/list/{sharedID}",
      "note": "direct id without extra headers 500s — needs session/Referer like browser; AROKI uses /ajax/server/list?servers={episodeID}"
    },
    "response": {
      "format": "json-wrapped-html"
    },
    "extract": {
      "collection": ".episodes ul.ep-range li",
      "fields": {
        "episodeID": "a[data-ids]",
        "episodeNumber": "a[data-num]",
        "variants": "sub/dub dropdown"
      },
      "seriesRule": "flat Season 1, ranges pages (?ep=N)"
    }
  },
  "streams": {
    "servers": [
      "HD-1",
      "HD-3",
      "Vidstream",
      "Kiwi"
    ],
    "pattern": "/api/v2/hianime/episode/servers?animeEpisodeId=&ep= -> /episode/sources?server=hd-1&category={sub|dub}",
    "response": {
      "format": "hls",
      "subtitles": "VTT multi + intro/outro timestamps"
    },
    "headers": {
      "Referer": "megaplay host"
    },
    "okoMap": "Episode{seasonNumber=1, episodeNumber, title} + FileInfo{url=m3u8} + subtitles[]"
  },
  "notes": {
    "blockers": [
      "Cloudflare on primary (anichi fallback works)",
      "server-IP AJAX block without session",
      "popups"
    ],
    "confidence": "high",
    "verified": "2026-10-01 (ops: home/filter HTML, ajax episodes, koto bridge streams)"
  },
  "icon": "icons/anikoto.png",
  "ops": {
    "discovery": {
      "sections": [
        {
          "id": "trending",
          "title": "Trending",
          "request": {
            "method": "GET",
            "urlTemplate": "{mirror}/home"
          },
          "response": {
            "format": "html"
          },
          "items": {
            "collection": ".ani.items .item",
            "fields": {
              "sourceID": {
                "selector": "a.name.d-title",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "{origin}/watch/"
                  },
                  {
                    "op": "removeSuffix",
                    "value": "/ep-1"
                  }
                ]
              },
              "title": {
                "selector": "a.name.d-title",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "div.poster img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        },
        {
          "id": "most-watched",
          "title": "Most Watched",
          "request": {
            "method": "GET",
            "urlTemplate": "{mirror}/filter?sort=most_watched&page={page}"
          },
          "response": {
            "format": "html"
          },
          "items": {
            "collection": "#list-items div.item",
            "fields": {
              "sourceID": {
                "selector": "a.name.d-title",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "{origin}/watch/"
                  },
                  {
                    "op": "removeSuffix",
                    "value": "/ep-1"
                  }
                ]
              },
              "title": {
                "selector": "a.name.d-title",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "div.poster img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        },
        {
          "id": "top-rated",
          "title": "Top Rated",
          "request": {
            "method": "GET",
            "urlTemplate": "{mirror}/filter?sort=score&page={page}"
          },
          "response": {
            "format": "html"
          },
          "items": {
            "collection": "#list-items div.item",
            "fields": {
              "sourceID": {
                "selector": "a.name.d-title",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "{origin}/watch/"
                  },
                  {
                    "op": "removeSuffix",
                    "value": "/ep-1"
                  }
                ]
              },
              "title": {
                "selector": "a.name.d-title",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "div.poster img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "{mirror}/filter?keyword={query}&page={page}"
      },
      "response": {
        "format": "html"
      },
      "items": {
        "collection": "#list-items div.item",
        "fields": {
          "sourceID": {
            "selector": "a.name.d-title",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "{origin}/watch/"
              },
              {
                "op": "removeSuffix",
                "value": "/ep-1"
              }
            ]
          },
          "title": {
            "selector": "a.name.d-title",
            "part": "text",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          },
          "posterURL": {
            "selector": "div.poster img",
            "part": "attr",
            "attr": "src"
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "{mirror}/watch/{id}",
        "altTemplates": [
          "{mirror}/anime/{id}"
        ]
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "title": {
          "selector": [
            "h1.media-title a",
            "h1.title",
            "h1"
          ],
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "synopsis": {
          "selector": [
            ".synopsis-short p",
            ".desc",
            ".synopsis p",
            ".synopsis"
          ],
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "posterURL": {
          "selector": "meta[property=\"og:image\"]",
          "part": "attr",
          "attr": "content"
        },
        "genres": {
          "collection": "a[href*=\"/genre/\"]"
        }
      }
    },
    "episodes": {
      "sharedFrom": {
        "request": {
          "method": "GET",
          "urlTemplate": "{mirror}/watch/{id}"
        },
        "field": {
          "selector": "#watch-main",
          "part": "attr",
          "attr": "data-id"
        },
        "altTemplates": [
          "{mirror}/anime/{id}"
        ]
      },
      "request": {
        "method": "GET",
        "urlTemplate": "{mirror}/ajax/episode/list/{sharedID}",
        "headers": {
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "{mirror}/watch/{id}"
        }
      },
      "response": {
        "format": "json",
        "unwrap": "result"
      },
      "items": {
        "collection": "li[title]",
        "fields": {
          "episodeID": {
            "selector": "a",
            "part": "attr",
            "attr": "data-id"
          },
          "episodeNumber": {
            "selector": "a",
            "part": "attr",
            "attr": "data-num"
          },
          "title": {
            "selector": "self",
            "part": "attr",
            "attr": "title"
          },
          "variantSub": {
            "selector": "a",
            "part": "attr",
            "attr": "data-sub"
          },
          "variantDub": {
            "selector": "a",
            "part": "attr",
            "attr": "data-dub"
          }
        }
      }
    },
    "streams": {
      "variants": [
        "sub",
        "dub"
      ],
      "steps": [
        {
          "request": {
            "method": "GET",
            "urlTemplate": "{mirror}/watch/{id}"
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "context": {
              "title": {
                "selector": "h1.media-title a",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikage.cc/api/media/anime/browse?q={title}&page=1"
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "context": {
              "slug": {
                "collection": "data[*]",
                "match": {
                  "against": "{title}",
                  "fields": [
                    "title.english",
                    "title.userPreferred",
                    "title.romaji"
                  ]
                },
                "pick": "slug",
                "failClosed": true
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikage.cc/api/media/anime/{slug}/episodes/{episodeID}/sources?provider=koto&lang={variant}&refresh=1",
            "headers": {
              "Referer": "https://anikage.cc/",
              "Origin": "https://anikage.cc"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "collection": "sources[*]",
            "fields": {
              "url": {
                "path": "url",
                "transforms": [
                  {
                    "op": "template",
                    "value": "https://og.bakayaro.live/{value}"
                  }
                ]
              },
              "quality": "quality",
              "name": "quality"
            }
          }
        }
      ]
    }
  }
}
